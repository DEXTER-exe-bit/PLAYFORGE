# ==========================================
# PLAYFORGE Configuration Template (.env.example)
# Copy this file to '.env' and customize.
# WARNING: NEVER commit your real '.env' file!
# ==========================================

# --- Minecraft Java Edition Connection ---
# Server hostname or IP address (e.g., localhost, 127.0.0.1, or yourserver.aternos.me)
MC_HOST=localhost

# Server port (default: 25565; for LAN games or Aternos, use the active dynamic port)
MC_PORT=25565

# Bot's in-game username (1-16 characters)
MC_USERNAME=PlayForgeBot

# Target Minecraft Java Edition release version
MC_VERSION=1.21.4

# Authentication mode: 'offline' (for LAN worlds, TLauncher, cracked servers) or 'microsoft'
MC_AUTH=offline

# Handshake connection timeout in milliseconds (minimum: 1000)
MC_CONNECT_TIMEOUT_MS=30000

# Optional: Password if required by server login plugins or Microsoft accounts
# MC_PASSWORD=

# --- AI Integration (OpenAI-Compatible / Nemotron Endpoint) ---
# Base URL for OpenAI-compatible completions API (planned for v0.3.0)
AI_API_BASE_URL=http://localhost:8000/v1

# API Key (leave empty if endpoint does not require authentication)
AI_API_KEY=

# Model ID identifier
AI_MODEL_ID=nemotron
